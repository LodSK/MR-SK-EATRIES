# ─────────────────────────────────────────────
# MR_SK EATRIES — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mrsk_eatries?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/mrsk_eatries_test

# Redis (sessions, caching, rate-limit store)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=replace_with_different_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_COOKIE_NAME=mrsk_refresh_token

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Email (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM="MR_SK EATRIES <noreply@mrsk-eatries.com>"

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMS-ready (Twilio placeholders — architecture only)
TWILIO_ACCOUNT_SID=replace_with_account_sid
TWILIO_AUTH_TOKEN=replace_with_auth_token
TWILIO_FROM_NUMBER=replace_with_from_number

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Admin bootstrap (seed script)
ADMIN_SEED_EMAIL=admin@mrsk-eatries.com
ADMIN_SEED_PASSWORD=replace_with_strong_temp_password

# AI (Sprint 13A) — the backend is the only thing that ever talks to the AI
# provider; these keys must never be exposed to the frontend.
# AI_PROVIDER selects which provider AIProviderFactory constructs: "groq" (default), "gemini", or "claude".
# Only the key for the provider you select needs to be real — the others can stay as placeholders.
AI_PROVIDER=groq
GROQ_API_KEY=replace_with_real_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=replace_with_real_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=replace_with_real_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_TOKENS=1024

PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

NEXT_PUBLIC_CLARITY_PROJECT_ID=