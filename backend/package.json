{
  "name": "mr-sk-eatries-backend",
  "version": "1.0.0",
  "private": true,
  "description": "MR_SK EATRIES — premium restaurant platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --transpile-only -r tsconfig-paths/register src/server.ts\"",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/seed/seed.ts",
    "media:upload": "ts-node --transpile-only -r tsconfig-paths/register src/scripts/upload-media-to-cloudinary.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@google/genai": "^2.15.0",
    "bcrypt": "5.1.1",
    "cloudinary": "2.10.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.5.0",
    "express-validator": "7.3.2",
    "groq-sdk": "^1.5.0",
    "helmet": "8.0.0",
    "hpp": "0.2.3",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.2",
    "morgan": "1.11.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "9.0.4",
    "rate-limit-redis": "^4.3.1",
    "slugify": "1.6.6",
    "socket.io": "4.8.1",
    "stripe": "17.5.0",
    "winston": "3.17.0",
    "winston-daily-rotate-file": "5.0.0",
    "xss-clean": "0.1.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/hpp": "0.2.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "eslint": "9.18.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.2",
    "nodemon": "3.1.9",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
