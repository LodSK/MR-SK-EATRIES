    "test:watch": "jest --watch",
    "seed": "ts-node --transpile-only src/utils/seed.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "mongoose": "8.9.5",
    "dotenv": "16.4.7",

    "jsonwebtoken": "9.0.2",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",

    "cors": "2.8.5",
    "helmet": "8.0.0",
    "express-rate-limit": "7.5.0",
    "express-mongo-sanitize": "2.2.0",
    "hpp": "0.2.3",
    "xss-clean": "0.1.4",
    "compression": "1.7.5",
    "morgan": "1.10.0",

    "multer": "1.4.5-lts.1",
    "cloudinary": "2.5.1",

    "socket.io": "4.8.1",
    "ioredis": "5.4.2",

