# ─────────────────────────────────────────────
# MR_SK EATRIES — FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME="MR_SK EATRIES"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Server-only override for Server Component fetches (menu/blog listings) —
# lets them hit the backend directly over a Docker network (e.g.
# http://backend:5000/api/v1) instead of round-tripping back out through
# nginx like real browser requests do. Optional: unset outside Docker,
# where it's simply the same URL as NEXT_PUBLIC_API_BASE_URL anyway. Never
# exposed to the browser bundle (no NEXT_PUBLIC_ prefix).
API_INTERNAL_BASE_URL=

# Auth
NEXT_PUBLIC_JWT_COOKIE_NAME=mrsk_access_token
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Cloudinary (menu images, gallery, avatars)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=mrsk_unsigned_preset
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Payments (Stripe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_maps_key

# Analytics / SEO
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-REPLACEME
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace_with_clarity_project_id
NEXT_PUBLIC_SITE_VERIFICATION=replace_with_search_console_code

# Chatbot / AI
NEXT_PUBLIC_CHATBOT_ENABLED=true

# PWA / Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
